# gemini | openai | anthropic | none
# none = template replies only (no API key needed)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional - defaults: gemini-2.5-flash / gpt-4o-mini / claude-haiku-4-5
LLM_MODEL=

LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=400
LLM_TEMPERATURE=0.3
DEFAULT_BUSINESS_NAME=Nexora Training Institute
